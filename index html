        // Phase Data Configuration Array with Google Drive links
        const phasesData = [
            { id: 1, title: "Phase 1", desc: "Core research and foundation setup.", link: "https://drive.google.com/file/d/1KdkEY0Xe2YzM9rAu3sGUY-pehgpnR8Ui/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1KdkEY0Xe2YzM9rAu3sGUY-pehgpnR8Ui/preview" },
            { id: 2, title: "Phase 2", desc: "Blueprint architecture and framework.", link: "https://drive.google.com/file/d/1X9Ks1RXfaIzxAPDtu5b6VbF9GCj0o2ve/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1X9Ks1RXfaIzxAPDtu5b6VbF9GCj0o2ve/preview" },
            { id: 3, title: "Phase 3", desc: "Front-end creation and UI magic.", link: "https://drive.google.com/file/d/1mqZhEpzqvuoQKLPwAz5LvoGvoVPY02aR/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1mqZhEpzqvuoQKLPwAz5LvoGvoVPY02aR/preview" },
            { id: 4, title: "Phase 4", desc: "Backend powerhouse integration.", link: "https://drive.google.com/file/d/1dwlfneWyINLbjlCejGTsETBOOWB62FN4/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1dwlfneWyINLbjlCejGTsETBOOWB62FN4/preview" },
            { id: 5, title: "Phase 5", desc: "System execution and feature synthesis.", link: "https://drive.google.com/file/d/1No1fCP8g6zi8eqXLdf3HHs1P4ZtaTmNr/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1No1fCP8g6zi8eqXLdf3HHs1P4ZtaTmNr/preview" },
            { id: 6, title: "Phase 6", desc: "High-speed performance tuning.", link: "https://drive.google.com/file/d/1vxe8abJ4LXyKeiM3o-OcN5SongG1Tdp7/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1vxe8abJ4LXyKeiM3o-OcN5SongG1Tdp7/preview" },
            { id: 7, title: "Phase 7", desc: "Comprehensive QA and stress testing.", link: "https://drive.google.com/file/d/17uq2qok9FCS_0LV5JFu2MscInkEHwmP_/view?usp=drivesdk", preview: "https://drive.google.com/file/d/17uq2qok9FCS_0LV5JFu2MscInkEHwmP_/preview" },
            { id: 8, title: "Phase 8", desc: "User feedback and final refinement.", link: "https://drive.google.com/file/d/1q9__2o7I30S2jMvglEGnQ3bJjaPkravk/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1q9__2o7I30S2jMvglEGnQ3bJjaPkravk/preview" },
            { id: 9, title: "Phase 9", desc: "Deployment readiness and staging.", link: "https://drive.google.com/file/d/14KUdXlY4zT42OKUHPTtQeARFYaxYfUBS/view?usp=drivesdk", preview: "https://drive.google.com/file/d/14KUdXlY4zT42OKUHPTtQeARFYaxYfUBS/preview" },
            { id: 10, title: "Phase 10", desc: "Grand launch and total victory!", link: "https://drive.google.com/file/d/1tql8ZYsDVtEaFuXKJVyzLurE1EBNbm44/view?usp=drivesdk", preview: "https://drive.google.com/file/d/1tql8ZYsDVtEaFuXKJVyzLurE1EBNbm44/preview" }
        ];

        let completedPhases = JSON.parse(localStorage.getItem('completedPhases_harsh')) || [];

        // Render Cards with Motivation tags
        function renderCards() {
            const grid = document.getElementById('phases-grid');
            grid.innerHTML = '';

            phasesData.forEach((phase, index) => {
                const isChecked = completedPhases.includes(phase.id);
                
                const card = document.createElement('div');
                card.className = `phase-card ${isChecked ? 'completed' : ''}`;
                card.style.animationDelay = `${index * 0.07}s`;

                card.innerHTML = `
                    <div>
                        <div class="phase-header">
                            <span class="phase-number">P ${phase.id}</span>
                            <input type="checkbox" 
                                   class="status-checkbox" 
                                   title="Mark Done"
                                   ${isChecked ? 'checked' : ''} 
                                   onchange="togglePhase(${phase.id})">
                        </div>
                        <div class="phase-body">
                            <h3>${phase.title}</h3>
                            <div class="phase-motivation"><i class="fa-solid fa-fire"></i> ${phaseMotivations[index]}</div>
                            <p>${phase.desc}</p>
                        </div>
                    </div>
                    <div class="phase-footer">
                        <button class="phase-btn phase-btn-preview" 
                                title="Quick Preview" 
                                onclick="openPreview('${phase.preview}', '${phase.title}')">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <a href="${phase.link}" target="_blank" class="phase-btn phase-btn-open">
                            <span>Launch Phase</span> <i class="fa-solid fa-arrow-right-long"></i>
                        </a>
                    </div>
                `;
                grid.appendChild(card);
            });

            updateProgress();
        }

        function togglePhase(id) {
            if (completedPhases.includes(id)) {
                completedPhases = completedPhases.filter(item => item !== id);
            } else {
                completedPhases.push(id);
                showMotivationToast("PHASE CONQUERED!", `Harsh, you are unstoppable! Phase ${id} is completed.`);
            }
            localStorage.setItem('completedPhases_harsh', JSON.stringify(completedPhases));
            renderCards();
        }

        function updateProgress() {
            const total = phasesData.length;
            const count = completedPhases.length;
            const percentage = Math.round((count / total) * 100);

            document.getElementById('progress-bar').style.width = `${percentage}%`;
            document.getElementById('progress-text').innerText = `${count} / ${total} Completed (${percentage}%)`;
        }

        // Animated Cycling Dynamic Quote Header
        let quoteIndex = 0;
        function cycleQuotes() {
            const quoteElem = document.getElementById('quoteText');
            quoteElem.style.opacity = '0';
            quoteElem.style.transform = 'translateY(10px)';
            
            setTimeout(() => {
                quoteIndex = (quoteIndex + 1) % harshMotivations.length;
                quoteElem.innerText = harshMotivations[quoteIndex];
                quoteElem.style.opacity = '1';
                quoteElem.style.transform = 'translateY(0)';
            }, 400);
        }
        setInterval(cycleQuotes, 3500);

        // Toast Motivation System
        function showMotivationToast(title, message) {
            const toast = document.getElementById('motivationToast');
            document.getElementById('toastTitle').innerText = title;
            document.getElementById('toastMessage').innerText = message;
            
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 4000);
        }

        // Random Toast Trigger every 15 seconds to boost morale
        setInterval(() => {
            const randomMsg = harshMotivations[Math.floor(Math.random() * harshMotivations.length)];
            showMotivationToast("MOTIVATION BOOST!", randomMsg);
        }, 15000);

        // Modal Functionality
        function openPreview(url, title) {
            document.getElementById('modalTitle').innerHTML = `<i class="fa-solid fa-file-pdf"></i> ${title} - Preview`;
            document.getElementById('modalIframe').src = url;
            document.getElementById('previewModal').classList.add('active');
        }

        function closePreview() {
            document.getElementById('previewModal').classList.remove('active');
            document.getElementById('modalIframe').src = '';
        }

        document.getElementById('previewModal').addEventListener('click', function(e) {
            if (e.target === this) closePreview();
        });

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            renderCards();
            setTimeout(() => {
                showMotivationToast("WELCOME HARSH!", "Harsh, your vision is so awesome! Let's conquer all 10 phases!");
            }, 1000);
        });
    </script>
</body>
</html>
