    <style>
        /* ==========================================================================
           1. CORE STYLES & VARIABLES (Yellow, White, Red, Black Theme)
           ========================================================================== */
        :root {
            --bg-dark: #050507;
            --card-bg: rgba(18, 18, 22, 0.9);
            --primary-red: #ff0d38;
            --primary-red-hover: #d90028;
            --primary-yellow: #ffc700;
            --primary-yellow-glow: rgba(255, 199, 0, 0.5);
            --primary-red-glow: rgba(255, 13, 56, 0.5);
            --text-white: #ffffff;
            --text-muted: #a0a0ab;
            --border-color: rgba(255, 255, 255, 0.12);
            --transition-bounce: 0.5s cubic-bezier(0.68, -0.55, 0.26, 1.55);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-white);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(255, 13, 56, 0.18) 0%, transparent 45%),
                radial-gradient(circle at 85% 85%, rgba(255, 199, 0, 0.15) 0%, transparent 45%);
            background-attachment: fixed;
        }

        /* Animated Grid Overlay */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: 0;
            pointer-events: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #050507; }
        ::-webkit-scrollbar-thumb { background: var(--primary-red); border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary-yellow); }

        /* ==========================================================================
           2. DYNAMIC MOTIVATIONAL TICKER & HERO SECTION
           ========================================================================== */
        /* Animated Top Banner Ticker */
        .motivation-ticker {
            background: linear-gradient(90deg, var(--primary-red), #99001a, #000, #99001a, var(--primary-red));
            background-size: 200% auto;
            color: #fff;
            padding: 10px 0;
            font-size: 0.95rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            overflow: hidden;
            white-space: nowrap;
            position: relative;
            z-index: 10;
            box-shadow: 0 0 20px rgba(255, 13, 56, 0.4);
            animation: gradientMove 6s linear infinite;
        }

        .ticker-track {
            display: inline-block;
            white-space: nowrap;
            animation: scrollTicker 25s linear infinite;
        }

        .ticker-item {
            display: inline-block;
            margin: 0 25px;
        }

        .ticker-item i {
            color: var(--primary-yellow);
            margin-right: 8px;
        }

        header {
            padding: 3rem 5% 2rem 5%;
            text-align: center;
            position: relative;
            z-index: 10;
        }

        .brand-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 3.2rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -1px;
            background: linear-gradient(135deg, #ffffff 30%, var(--primary-yellow) 70%, var(--primary-red) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            text-shadow: 0 0 30px rgba(255, 199, 0, 0.2);
            animation: pulseGlow 3s ease-in-out infinite alternate;
        }

        /* Large Animated Motivational Statement */
        .hero-quote-box {
            background: rgba(255, 199, 0, 0.08);
            border: 1px solid var(--primary-yellow);
            border-radius: 16px;
            padding: 18px 25px;
            max-width: 800px;
            margin: 20px auto;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 25px var(--primary-yellow-glow);
            position: relative;
            overflow: hidden;
        }

        .hero-quote {
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            min-height: 40px;
            transition: all 0.5s ease;
        }

        .hero-quote i {
            color: var(--primary-yellow);
            font-size: 1.5rem;
        }

        /* Progress Bar */
        .progress-container {
            max-width: 550px;
            margin: 25px auto 0 auto;
            background: rgba(255, 255, 255, 0.04);
            padding: 18px 22px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            backdrop-filter: blur(10px);
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            font-size: 0.95rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .progress-label span:nth-child(2) { color: var(--primary-yellow); }

        .progress-bar-bg {
            width: 100%;
            height: 12px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
        }

        .progress-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary-red), var(--primary-yellow));
            border-radius: 10px;
            transition: width 0.8s ease-in-out;
            box-shadow: 0 0 15px var(--primary-yellow-glow);
        }

        /* ==========================================================================
           3. OVERVIEW BANNER (MASTER HUB)
           ========================================================================== */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px 60px 20px;
            width: 100%;
            position: relative;
            z-index: 5;
        }

        .overview-card {
            background: linear-gradient(135deg, rgba(255, 13, 56, 0.25) 0%, rgba(18, 18, 22, 0.95) 100%);
            border: 2px solid var(--primary-red);
            border-radius: 22px;
            padding: 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(255, 13, 56, 0.3);
            transition: transform 0.4s ease, box-shadow 0.4s ease;
            margin-bottom: 45px;
        }

        .overview-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 45px rgba(255, 13, 56, 0.5);
        }

        .overview-info h2 {
            font-size: 2rem;
            color: var(--text-white);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

        .overview-info h2 i { color: var(--primary-yellow); }
        .overview-info p { color: var(--text-muted); font-size: 1rem; }

        .overview-actions { display: flex; gap: 15px; z-index: 2; }

        /* ==========================================================================
           4. BUTTONS & UI CONTROLS
           ========================================================================== */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 26px;
            border-radius: 12px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-yellow {
            background: var(--primary-yellow);
            color: #000;
            box-shadow: 0 5px 20px rgba(255, 199, 0, 0.4);
        }

        .btn-yellow:hover {
            background: #ffffff;
            transform: translateY(-3px) scale(1.03);
            box-shadow: 0 8px 25px rgba(255, 255, 255, 0.5);
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-white);
            border: 1px solid var(--border-color);
            backdrop-filter: blur(5px);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.2);
            color: var(--primary-yellow);
            border-color: var(--primary-yellow);
            transform: translateY(-2px);
        }

        /* ==========================================================================
           5. PHASES GRID & CARDS
           ========================================================================== */
        .section-title {
            font-size: 1.7rem;
            font-weight: 800;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-left: 5px solid var(--primary-yellow);
            padding-left: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .phases-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 25px;
        }

        .phase-card {
            background: var(--card-bg);
            border-radius: 20px;
            border: 1px solid var(--border-color);
            padding: 25px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            opacity: 0;
            transform: translateY(40px);
            animation: fadeInUp 0.6s forwards;
            overflow: hidden;
        }

        .phase-card:hover {
            transform: translateY(-10px) scale(1.02);
            border-color: var(--primary-yellow);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 25px var(--primary-yellow-glow);
        }

        /* Card Header */
        .phase-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .phase-number {
            font-size: 1.2rem;
            font-weight: 900;
            color: #000;
            background: var(--primary-yellow);
            padding: 6px 16px;
            border-radius: 10px;
            box-shadow: 0 0 10px var(--primary-yellow-glow);
        }

        .status-checkbox {
            appearance: none;
            width: 24px;
            height: 24px;
            border: 2px solid var(--text-muted);
            border-radius: 7px;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
        }

        .status-checkbox:checked {
            background-color: var(--primary-red);
            border-color: var(--primary-red);
            box-shadow: 0 0 10px var(--primary-red-glow);
        }

        .status-checkbox:checked::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: white;
            font-size: 13px;
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
        }

        /* Card Body */
        .phase-body h3 {
            font-size: 1.3rem;
            font-weight: 800;
            margin-bottom: 8px;
            color: var(--text-white);
            transition: color 0.3s ease;
        }

        .phase-card:hover .phase-body h3 { color: var(--primary-yellow); }

        /* Card Specific Motivation Subtext */
        .phase-motivation {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--primary-yellow);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .phase-body p {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 22px;
            line-height: 1.5;
        }

        /* Card Action Links */
        .phase-footer { display: flex; gap: 10px; margin-top: auto; }

        .phase-btn {
            flex: 1;
            text-align: center;
            padding: 12px 0;
            border-radius: 12px;
            font-size: 0.88rem;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .phase-btn-open {
            background: linear-gradient(45deg, var(--primary-red), var(--primary-red-hover));
            color: var(--text-white);
            box-shadow: 0 4px 15px rgba(255, 13, 56, 0.3);
        }

        .phase-btn-open:hover {
            background: linear-gradient(45deg, var(--primary-red-hover), var(--primary-red));
            transform: scale(1.03);
            box-shadow: 0 6px 20px rgba(255, 13, 56, 0.6);
        }

        .phase-btn-preview {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-white);
            border: 1px solid var(--border-color);
            width: 44px;
            flex: 0 0 44px;
        }

        .phase-btn-preview:hover {
            background: var(--primary-yellow);
            color: #000;
            border-color: var(--primary-yellow);
        }

        /* Completed State */
        .phase-card.completed {
            border-color: rgba(255, 13, 56, 0.5);
            background: rgba(20, 8, 12, 0.85);
        }

        .phase-card.completed .phase-number {
            background: var(--primary-red);
            color: #fff;
            box-shadow: 0 0 10px var(--primary-red-glow);
        }

        /* ==========================================================================
           6. POPUP MOTIVATION TOAST
           ========================================================================== */
        .toast-container {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast {
            background: rgba(18, 18, 22, 0.95);
            border-left: 5px solid var(--primary-yellow);
            border-top: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            color: #fff;
            padding: 16px 22px;
            border-radius: 14px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 15px var(--primary-yellow-glow);
            display: flex;
            align-items: center;
            gap: 15px;
            transform: translateX(120%);
            transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.26, 1.55);
        }

        .toast.show { transform: translateX(0); }

        .toast i { font-size: 1.5rem; color: var(--primary-yellow); }
        .toast-content h4 { font-size: 0.95rem; font-weight: 800; color: var(--primary-yellow); }
        .toast-content p { font-size: 0.85rem; color: var(--text-white); }

        /* ==========================================================================
           7. MODAL SYSTEM (DRIVE PREVIEW)
           ========================================================================== */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.88);
            backdrop-filter: blur(10px);
            z-index: 1500;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active { opacity: 1; pointer-events: all; }

        .modal-container {
            background: #101014;
            width: 90%;
            max-width: 950px;
            height: 82vh;
            border-radius: 22px;
            border: 2px solid var(--primary-red);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.9), 0 0 30px var(--primary-red-glow);
            transform: scale(0.85);
            transition: transform 0.3s var(--transition-bounce);
        }

        .modal-overlay.active .modal-container { transform: scale(1); }

        .modal-header {
            padding: 16px 25px;
            background: #18181e;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .modal-header h3 { font-size: 1.1rem; color: var(--primary-yellow); font-weight: 700; }
        .modal-close { background: transparent; border: none; color: var(--text-muted); font-size: 1.3rem; cursor: pointer; }
        .modal-close:hover { color: var(--primary-red); }

        .modal-body { flex: 1; background: #000; }
        .modal-body iframe { width: 100%; height: 100%; border: none; }

        /* ==========================================================================
           8. ANIMATIONS
           ========================================================================== */
        @keyframes scrollTicker {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            100% { background-position: 200% 50%; }
        }

        @keyframes pulseGlow {
            0% { text-shadow: 0 0 20px rgba(255, 199, 0, 0.2); }
            100% { text-shadow: 0 0 40px rgba(255, 13, 56, 0.6), 0 0 20px rgba(255, 199, 0, 0.8); }
        }

        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }

        footer {
            margin-top: auto;
            text-align: center;
            padding: 25px;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 0.9rem;
            background: rgba(5, 5, 7, 0.9);
            position: relative;
            z-index: 5;
        }

        footer span { color: var(--primary-yellow); font-weight: 700; }

        @media (max-width: 768px) {
            .brand-title { font-size: 2.2rem; }
            .overview-card { flex-direction: column; text-align: center; gap: 20px; }
            .overview-actions { width: 100%; flex-direction: column; }
            .overview-actions .btn { width: 100%; justify-content: center; }
            .hero-quote { font-size: 1.05rem; }
        }
    </style>
</head>
